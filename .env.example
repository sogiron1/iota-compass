# Names only. Set values in Vercel > Project > Settings > Environment Variables.
# Never commit values. Secrets marked [SECRET] are entered by Steve directly.
APP_BASE_URL=                  # e.g. https://iota-compass.vercel.app (no trailing slash)
MIGHTY_NETWORK_HOST=           # the-new-human-university.mn.co
MIGHTY_NETWORK_ID=             # 13510327
MIGHTY_OAUTH_CLIENT_ID=        # from Admin > OAuth Applications
MIGHTY_OAUTH_CLIENT_SECRET=    # [SECRET]
DATABASE_URL=                  # [SECRET] Neon pooled connection string (neondb_owner)
TOKEN_ENCRYPTION_KEY=          # [SECRET, optional] 32 random bytes base64; else derived via HKDF
EMBED_AUTH_MODE=               # popup | iframe  (iframe = sign-in inside the Mighty embed)
FRAME_ANCESTORS=               # optional override of allowed Mighty frame origins
ADMIN_ALERT_WEBHOOK_URL=       # optional; receives "sync needs attention" (no answer text)
COMPASS_TEST_MODE=             # 1 only during the Phase 0 test; unset in production
COMPASS_TEST_FIELD_ID=         # GlobalID of the disposable test field (Phase 0 only)
